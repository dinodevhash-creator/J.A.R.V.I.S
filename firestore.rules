rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 16000 &&
             data.errorFlag is bool &&
             (!('actionType' in data) || (data.actionType is string && data.actionType.size() <= 64)) &&
             (!('actionLabel' in data) || (data.actionLabel is string && data.actionLabel.size() <= 160)) &&
             (!('actionPayload' in data) || (data.actionPayload is string && data.actionPayload.size() <= 4000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirective(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
             data.priority in ['HIGH', 'NORMAL', 'ROUTINE'] &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId) && isValidId(messageId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(messageId) &&
                       incoming().keys().hasAll(['userId', 'role', 'text', 'errorFlag', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'role', 'text', 'actionType', 'actionLabel', 'actionPayload', 'errorFlag', 'createdAt', 'updatedAt']) &&
                       isValidMessage(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(messageId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidMessage(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['text', 'actionType', 'actionLabel', 'actionPayload', 'errorFlag', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(messageId);
    }

    match /users/{userId}/directives/{directiveId} {
      allow get: if isOwner(userId) && isValidId(directiveId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(directiveId) &&
                       incoming().keys().hasAll(['userId', 'title', 'priority', 'completed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'priority', 'completed', 'createdAt', 'updatedAt']) &&
                       isValidDirective(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(directiveId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidDirective(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'priority', 'completed', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(directiveId);
    }
  }
}
